# =============================================================================
# Ocean Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Host and port for the FastAPI server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (disable in production)
DEBUG=true

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS
# Tauri dev server typically runs on http://localhost:1420 or tauri://localhost
CORS_ORIGINS=http://localhost:1420,tauri://localhost,http://localhost:5173,http://127.0.0.1:1420,http://127.0.0.1:5173

# Allow credentials in CORS requests
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Path to SQLite database file (absolute or relative to backend/)
# Default: ./storage/local_files/data/ocean.db
DATABASE_PATH=./storage/local_files/data/ocean.db

# Database connection pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Enable SQL query logging (disable in production for performance)
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Google OAuth Configuration
# -----------------------------------------------------------------------------
# Get these from Google Cloud Console: https://console.cloud.google.com/
# Create OAuth 2.0 Client ID credentials (Desktop app type)
GOOGLE_CLIENT_ID=29879173672-dlbfg0ea9cvmr69afembebpi1reqbg55.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# OAuth redirect URI (must match Google Cloud Console configuration)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/auth/callback

# OAuth scopes (space-separated)
# Default scopes for Gmail and Drive read access
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/userinfo.email

# -----------------------------------------------------------------------------
# AI Assistant Configuration
# -----------------------------------------------------------------------------
# Choose AI provider: anthropic, openai
AI_PROVIDER=anthropic

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI ChatGPT API Configuration (alternative)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Max tokens for AI responses
AI_MAX_TOKENS=4096

# Temperature for AI responses (0.0 - 1.0)
AI_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
# Base directory for file storage
STORAGE_BASE_PATH=./storage/local_files

# Cache directory for thumbnails and previews
CACHE_DIR=./storage/local_files/cache

# Maximum cache size in MB
CACHE_MAX_SIZE_MB=500

# Cache cleanup interval in hours
CACHE_CLEANUP_INTERVAL_HOURS=24

# Thumbnail generation settings
THUMBNAIL_MAX_WIDTH=400
THUMBNAIL_MAX_HEIGHT=400
THUMBNAIL_QUALITY=85

# Text preview settings (number of lines to extract)
TEXT_PREVIEW_LINES=10

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Secret key for encryption (generate a strong random key in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Token encryption key (for Google OAuth tokens)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-this-to-a-random-encryption-key-in-production

# Session timeout in seconds (default: 30 days)
SESSION_TIMEOUT_SECONDS=2592000

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json, text
LOG_FORMAT=json

# Log output: console, file, both
LOG_OUTPUT=file

# Log file path (used if LOG_OUTPUT is file or both)
LOG_FILE_PATH=./logs/ocean.log

# Enable log file rotation
LOG_FILE_ROTATION=true

# Max log file size in MB before rotation
LOG_FILE_MAX_SIZE_MB=10

# Number of backup log files to keep
LOG_FILE_BACKUP_COUNT=5

# Enable request/response logging
LOG_REQUESTS=true

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable Google integration features
FEATURE_GOOGLE_INTEGRATION=true

# Enable AI assistant features
FEATURE_AI_ASSISTANT=true

# Enable thumbnail generation
FEATURE_THUMBNAILS=true

# Enable preview generation
FEATURE_PREVIEWS=true

# -----------------------------------------------------------------------------
# Development/Testing
# -----------------------------------------------------------------------------
# Enable API documentation (Swagger UI)
ENABLE_API_DOCS=true

# Enable OpenAPI schema endpoint
ENABLE_OPENAPI_SCHEMA=true

# Mock external APIs (for testing without real credentials)
MOCK_EXTERNAL_APIS=false
