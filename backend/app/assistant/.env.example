# Alfy Environment Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Choose which LLM provider to use: "local", "claude", or "openai"
# Default: claude
ALFY_LLM_PROVIDER=claude

# =============================================================================
# Claude API Configuration (when ALFY_LLM_PROVIDER=claude)
# =============================================================================

# Your Anthropic API key (required for Claude)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=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

# Claude model to use
# Options:
#   - claude-3-5-haiku-20241022 (fastest, lower cost) ← RECOMMENDED for Alfy
#   - claude-3-5-sonnet-20241022 (best balance of speed/quality)
#   - claude-3-7-sonnet-20250219 (newest sonnet)
#   - claude-3-5-opus-20241022 (higher quality, slower)
#   - claude-opus-4-5-20251101 (latest opus, highest quality)
# Default: claude-3-5-haiku-20241022
ALFY_CLAUDE_MODEL=claude-3-5-haiku-20241022

# Maximum tokens to generate (Claude API)
# Default: 4096
ALFY_CLAUDE_MAX_TOKENS=4096

# Temperature for Claude responses (0.0-1.0)
# Lower = more focused, Higher = more creative
# Default: 0.7
ALFY_CLAUDE_TEMPERATURE=0.3

# =============================================================================
# OpenAI API Configuration (when ALFY_LLM_PROVIDER=openai)
# =============================================================================

# Your OpenAI API key (required for OpenAI)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# OpenAI model to use
# Options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo, etc.
# Default: gpt-4
ALFY_OPENAI_MODEL=gpt-4

# =============================================================================
# Local LLM Configuration (when ALFY_LLM_PROVIDER=local)
# =============================================================================

# Path to local router model (used for intent classification)
# Default: llm_models/qwen3-1.7b-q4_k_m.gguf
ALFY_LOCAL_ROUTER_MODEL=llm_models/qwen3-1.7b-q4_k_m.gguf

# Path to local agent model (used for generating responses)
# Default: llm_models/qwen3-8b-q4_k_m.gguf
ALFY_LOCAL_AGENT_MODEL=llm_models/qwen3-8b-q4_k_m.gguf

# Context window size for local models
# Default: 2048
ALFY_LOCAL_N_CTX=2048

# Number of CPU threads to use for inference
# Default: 4
ALFY_LOCAL_N_THREADS=4

# Batch size for local model processing
# Default: 512
ALFY_LOCAL_N_BATCH=512

# Maximum tokens to generate (local LLM)
# Default: 512
ALFY_LOCAL_MAX_TOKENS=512

# Temperature for local LLM responses (0.0-1.0)
# Default: 0.7
ALFY_LOCAL_TEMPERATURE=0.3

# =============================================================================
# API Server Configuration
# =============================================================================

# Host to bind the API server to
# Default: 127.0.0.1
ALFY_API_HOST=127.0.0.1

# Port to bind the API server to
# Default: 8001
ALFY_API_PORT=8001

# Enable auto-reload for development
# Default: false
ALFY_API_RELOAD=false

# =============================================================================
# Database Configuration
# =============================================================================

# Database URL (SQLite by default)
# Default: sqlite:///./alfy.db
ALFY_DATABASE_URL=sqlite:///./alfy.db

# =============================================================================
# Google Drive OAuth 2.0 Configuration
# =============================================================================

# Google OAuth 2.0 Client ID and Secret
# Get these from: https://console.cloud.google.com/apis/credentials
# 1. Create a new project or select existing one
# 2. Enable Google Drive API
# 3. Create OAuth 2.0 credentials (Desktop app)
# 4. Download the credentials JSON or copy Client ID and Secret

#GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=your-client-secret-here

# Optional: Path to Google OAuth credentials JSON file
# If provided, this will be used instead of CLIENT_ID and CLIENT_SECRET
# GOOGLE_CREDENTIALS_PATH=path/to/credentials.json

# OAuth Scopes for Google Drive (comma-separated)
# Default: https://www.googleapis.com/auth/drive.readonly
# Options:
#   - drive.readonly: Read-only access to all files
#   - drive.file: Access to files created by the app
#   - drive: Full access to all files
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly
